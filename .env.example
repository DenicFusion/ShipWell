# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Application Config
APP_URL="https://shipwell.cc"
NEXT_PUBLIC_APP_URL="https://shipwell.cc"

# Master AES-256-GCM encryption key for adminSecrets (32+ bytes hex or base64 or passphrase)
# Set once on deployment / Firebase Secret Manager. All gateway & Resend keys live in Admin Settings.
SETTINGS_ENCRYPTION_KEY=""

# Fallback Transactional Email (Resend) when Admin Settings is not yet configured
RESEND_API_KEY=""
EMAIL_FROM="ShipWell <notifications@mail.shipwell.cc>"
EMAIL_REPLY_TO="support@mail.shipwell.cc"
SUPPORT_INBOX="support@mail.shipwell.cc"
RESEND_INBOUND_SECRET=""

# Invite Token Signing (32+ random characters in production)
INVITE_TOKEN_SECRET=""