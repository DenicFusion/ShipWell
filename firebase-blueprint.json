    },
    "adminSecrets/{docId}": {
      "schema": { "type": "object" },
      "description": "Server-only AES-256-GCM encrypted API keys and webhook secrets."
    },
    "bachsEvents/{eventId}": {
      "schema": { "type": "object" },
      "description": "Server-only webhook idempotency deduplication store."
    },
    "emailDedup/{dedupKey}": {
      "schema": { "type": "object" },
      "description": "Server-only email trigger deduplication store."
    },
    "webhookLogs/{logId}": {
      "schema": { "$ref": "WebhookEventLog" },
      "description": "Webhook verification history visible to admins."
    },
    "bookings/{bookingId}": {
      "schema": { "$ref": "Booking" },
      "description": "Server-managed parcel bookings and payment checkout status."
    }
  }
}
