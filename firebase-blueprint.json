{
  "entities": {
    "User": {
      "title": "User",
      "description": "Registered customer profile metadata (strictly PII-isolated).",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "phone": { "type": "string", "maxLength": 40 },
        "company": { "type": "string", "maxLength": 160 },
        "theme": { "type": "string", "enum": ["system", "dark", "light"] },
        "prefs": { "type": "object", "description": "Email notification toggles (onway, scan, action)" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["uid", "name", "email", "createdAt", "updatedAt"]
    },
    "AccountStatus": {
      "title": "AccountStatus",
      "description": "Non-PII existence flag keyed by SHA-256 hash of lowercase email.",
      "type": "object",
      "properties": {
        "exists": { "type": "boolean" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["exists", "updatedAt"]
    },
    "TrackingTeaser": {
      "title": "TrackingTeaser",
      "description": "Public non-PII tracking summary for the pre-login gate.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^SW-\\d{8}-[A-F0-9]{8}$", "maxLength": 20 },
        "senderId": { "type": "string", "maxLength": 128 },
        "status": {
          "type": "string",
          "enum": ["Booked", "Picked Up", "In Transit", "At Hub", "Customs", "Out for Delivery", "Delivered"]
        },
        "holdType": { "type": "string", "maxLength": 30 },
        "originCity": { "type": "string", "maxLength": 100 },
        "originCountry": { "type": "string", "maxLength": 100 },
        "destinationCity": { "type": "string", "maxLength": 100 },
        "destinationCountry": { "type": "string", "maxLength": 100 },
        "service": { "type": "string", "enum": ["economy", "standard", "express"] },
        "weightKg": { "type": "number" },
        "contents": { "type": "string", "maxLength": 240 },
        "eta": { "type": "number" },
        "deliveredAt": { "type": "number" },
        "latestEvent": { "type": "object" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": [
        "code", "senderId", "status", "originCity", "originCountry",
        "destinationCity", "destinationCountry", "service", "weightKg",
        "contents", "eta", "createdAt", "updatedAt"
      ]
    },
    "Shipment": {
      "title": "Shipment",
      "description": "Full shipment record restricted to sender, verified receiver, and admins.",
      "type": "object",
      "properties": {
        "code": { "type": "string", "pattern": "^SW-\\d{8}-[A-F0-9]{8}$", "maxLength": 20 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "receiverEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "sender": { "type": "object" },
        "receiver": { "type": "object" },
        "service": { "type": "string", "enum": ["economy", "standard", "express"] },
        "weightKg": { "type": "number" },
        "packageType": { "type": "string", "maxLength": 60 },
        "contents": { "type": "string", "maxLength": 240 },
        "declaredValue": { "type": "number" },
        "parcels": { "type": "array", "maxItems": 10 },
        "priceTotal": { "type": "number" },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "paymentMethodId": { "type": "string", "maxLength": 80 },
        "paymentMethodName": { "type": "string", "maxLength": 80 },
        "paymentChannel": { "type": "string", "maxLength": 40 },
        "feeAmount": { "type": "number" },
        "convertedAmount": { "type": "number" },
        "convertedCurrency": { "type": "string", "maxLength": 12 },
        "paymentWindowExpiresAt": { "type": "number" },
        "bookingId": { "type": "string", "maxLength": 128 },
        "paymentStatus": {
          "type": "string",
          "enum": ["awaiting_payment", "pending_review", "paid", "pay_on_pickup", "rejected", "info_requested", "failed", "expired", "refunded"]
        },
        "paymentReference": { "type": "string", "maxLength": 160 },
        "paymentId": { "type": "string", "maxLength": 160 },
        "checkoutExpiresAt": { "type": "number" },
        "bookingStatus": {
          "type": "string",
          "enum": ["awaiting_payment", "confirmed", "expired", "cancelled"]
        },
        "status": {
          "type": "string",
          "enum": ["Booked", "Picked Up", "In Transit", "At Hub", "Customs", "Out for Delivery", "Delivered"]
        },
        "eta": { "type": "number" },
        "photos": { "type": "array" },
        "hold": { "type": "object" },
        "nextStop": { "type": "object" },
        "review": { "type": "object" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": [
        "code", "senderId", "senderEmail", "receiverEmail", "sender", "receiver",
        "service", "weightKg", "packageType", "contents", "declaredValue",
        "priceTotal", "paymentMethod", "status", "eta", "photos", "review",
        "createdAt", "updatedAt"
      ]
    },
    "Booking": {
      "title": "Booking",
      "description": "Server-authoritative parcel booking and payment checkout session.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "pattern": "^SW-\\d{8}-[A-F0-9]{8}$", "maxLength": 20 },
        "uid": { "type": "string", "maxLength": 128 },
        "senderEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "receiverEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "service": { "type": "string", "enum": ["economy", "standard", "express"] },
        "weightKg": { "type": "number" },
        "declaredValue": { "type": "number" },
        "parcels": { "type": "array", "maxItems": 10 },
        "total": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "paymentMethod": { "type": "string", "maxLength": 80 },
        "paymentMethodId": { "type": "string", "maxLength": 80 },
        "paymentChannel": { "type": "string", "maxLength": 40 },
        "paymentStatus": {
          "type": "string",
          "enum": ["awaiting_payment", "pending_review", "paid", "pay_on_pickup", "rejected", "info_requested", "failed", "expired", "refunded"]
        },
        "bookingStatus": {
          "type": "string",
          "enum": ["awaiting_payment", "confirmed", "expired", "cancelled"]
        },
        "checkoutId": { "type": "string", "maxLength": 160 },
        "checkoutUrl": { "type": "string", "maxLength": 1024 },
        "paymentId": { "type": "string", "maxLength": 160 },
        "paymentReference": { "type": "string", "maxLength": 160 },
        "checkoutExpiresAt": { "type": "number" },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": [
        "id", "code", "uid", "service", "weightKg", "total", "currency",
        "paymentMethod", "paymentStatus", "bookingStatus"
      ]
    },
    "TrackingEvent": {
      "title": "TrackingEvent",
      "description": "Chronological milestone event on a shipment.",
      "type": "object",
      "properties": {
        "stage": {
          "type": "string",
          "enum": ["Booked", "Picked Up", "In Transit", "At Hub", "Customs", "Out for Delivery", "Delivered"]
        },
        "label": { "type": "string", "maxLength": 160 },
        "loc": { "type": "string", "maxLength": 160 },
        "note": { "type": "string", "maxLength": 500 },
        "kind": { "type": "string", "enum": ["scan", "delay", "action", "review", "info"] },
        "ts": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["stage", "label", "loc", "note", "kind", "ts", "createdBy", "createdAt"]
    },
    "ShipmentAlert": {
      "title": "ShipmentAlert",
      "description": "Action request and customs duty charges attached to a shipment.",
      "type": "object",
      "properties": {
        "to": { "type": "string", "enum": ["receiver", "sender"] },
        "kind": { "type": "string", "enum": ["duty", "address", "id", "reschedule", "custom", "item"] },
        "chargeType": { "type": "string", "maxLength": 80 },
        "currency": { "type": "string", "maxLength": 8 },
        "holdShipment": { "type": "boolean" },
        "title": { "type": "string", "maxLength": 160 },
        "message": { "type": "string", "maxLength": 600 },
        "amount": { "type": "number" },
        "status": { "type": "string", "enum": ["open", "resolved"] },
        "response": { "type": "string", "maxLength": 600 },
        "attachmentName": { "type": "string", "maxLength": 160 },
        "attachmentUrl": { "type": "string", "maxLength": 1024 },
        "payment": { "type": "object" },
        "createdAt": { "type": "timestamp" },
        "resolvedAt": { "type": "timestamp" }
      },
      "required": ["to", "kind", "title", "message", "amount", "status", "createdAt"]
    },
    "ShipmentInvite": {
      "title": "ShipmentInvite",
      "description": "Receiver invite and reminder dispatch history.",
      "type": "object",
      "properties": {
        "tokenHash": { "type": "string", "maxLength": 128 },
        "receiverEmail": { "type": "string", "format": "email", "maxLength": 160 },
        "template": { "type": "string", "enum": ["invite", "on_its_way", "reminder"] },
        "status": { "type": "string", "enum": ["sent", "queued_preview", "opened", "completed", "flagged_unknown", "unsubscribed"] },
        "emailCount": { "type": "number" },
        "sentAt": { "type": "number" },
        "openedAt": { "type": "number" },
        "completedAt": { "type": "number" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["tokenHash", "receiverEmail", "template", "status", "emailCount", "sentAt", "createdBy", "createdAt"]
    },
    "InviteAction": {
      "title": "InviteAction",
      "description": "Signed footer action records (unknown sender flag or reminder unsubscribe).",
      "type": "object",
      "properties": {
        "tokenHash": { "type": "string", "maxLength": 128 },
        "code": { "type": "string", "pattern": "^SW-\\d{8}-[A-F0-9]{8}$", "maxLength": 20 },
        "action": { "type": "string", "enum": ["unknown_sender", "unsubscribe"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["tokenHash", "code", "action", "createdAt"]
    },
    "BusinessLead": {
      "title": "BusinessLead",
      "description": "Enterprise shipping account enquiry.",
      "type": "object",
      "properties": {
        "ref": { "type": "string", "maxLength": 24 },
        "company": { "type": "string", "maxLength": 160 },
        "name": { "type": "string", "maxLength": 120 },
        "email": { "type": "string", "format": "email", "maxLength": 160 },
        "plan": { "type": "string", "enum": ["Starter", "Growth", "Enterprise"] },
        "volume": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 1500 },
        "status": { "type": "string", "enum": ["new", "contacted"] },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["ref", "company", "name", "email", "plan", "volume", "message", "status", "createdAt"]
    },
    "EmailLog": {
      "title": "EmailLog",
      "description": "Audit log of transactional emails sent or queued.",
      "type": "object",
      "properties": {
        "to": { "type": "string", "maxLength": 160 },
        "from": { "type": "string", "maxLength": 160 },
        "code": { "type": "string", "maxLength": 24 },
        "template": { "type": "string", "maxLength": 60 },
        "subject": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "enum": ["sent", "queued_preview", "failed", "delivered", "bounced"] },
        "providerId": { "type": "string", "maxLength": 128 },
        "htmlPreview": { "type": "string" },
        "createdBy": { "type": "string", "maxLength": 128 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["to", "template", "subject", "status", "createdBy", "createdAt"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Admin operations audit trail.",
      "type": "object",
      "properties": {
        "actorUid": { "type": "string", "maxLength": 128 },
        "actorEmail": { "type": "string", "maxLength": 160 },
        "action": { "type": "string", "maxLength": 80 },
        "code": { "type": "string", "maxLength": 24 },
        "detail": { "type": "string", "maxLength": 400 },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["actorUid", "actorEmail", "action", "detail", "createdAt"]
    },
    "SupportThread": {
      "title": "SupportThread",
      "description": "Customer and guest support ticket thread.",
      "type": "object",
      "properties": {
        "ticketCode": { "type": "string", "maxLength": 24 },
        "uid": { "type": "string", "maxLength": 128 },
        "userName": { "type": "string", "maxLength": 120 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "subject": { "type": "string", "maxLength": 200 },
        "code": { "type": "string", "maxLength": 24 },
        "status": { "type": "string", "enum": ["open", "closed"] },
        "source": { "type": "string", "enum": ["web", "email"] },
        "unreadAdmin": { "type": "boolean" },
        "unreadUser": { "type": "boolean" },
        "lastMessageAt": { "type": "number" },
        "lastMessagePreview": { "type": "string", "maxLength": 200 },
        "createdAt": { "type": "timestamp" },
        "updatedAt": { "type": "timestamp" }
      },
      "required": ["ticketCode", "userName", "userEmail", "subject", "status", "unreadAdmin", "unreadUser", "lastMessageAt"]
    },
    "SupportMessage": {
      "title": "SupportMessage",
      "description": "Individual message in a support thread.",
      "type": "object",
      "properties": {
        "from": { "type": "string", "enum": ["user", "admin"] },
        "senderName": { "type": "string", "maxLength": 120 },
        "senderEmail": { "type": "string", "maxLength": 160 },
        "body": { "type": "string", "maxLength": 4000 },
        "source": { "type": "string", "enum": ["web", "email"] },
        "ts": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["from", "senderName", "senderEmail", "body", "ts"]
    },
    "AdminPaymentSettings": {
      "title": "AdminPaymentSettings",
      "description": "Public/masked gateway configuration and routing metadata (never holds plaintext secrets).",
      "type": "object",
      "properties": {
        "bachs": { "type": "object" },
        "resend": { "type": "object" },
        "stripe": { "type": "object" },
        "paystack": { "type": "object" },
        "routing": { "type": "object" },
        "updatedAt": { "type": "number" },
        "updatedBy": { "type": "string" }
      }
    },
    "WebhookEventLog": {
      "title": "WebhookEventLog",
      "description": "Webhook verification and delivery audit log.",
      "type": "object",
      "properties": {
        "provider": { "type": "string", "maxLength": 40 },
        "eventType": { "type": "string", "maxLength": 120 },
        "reference": { "type": "string", "maxLength": 160 },
        "result": { "type": "string", "maxLength": 40 },
        "detail": { "type": "string", "maxLength": 400 },
        "environment": { "type": "string", "maxLength": 20 },
        "ts": { "type": "number" }
      },
      "required": ["provider", "eventType", "result", "ts"]
    },
    "ErrorLog": {
      "title": "ErrorLog",
      "description": "Booking and client/server diagnostic error events.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "step": { "type": "string", "maxLength": 80 },
        "code": { "type": "string", "maxLength": 80 },
        "message": { "type": "string", "maxLength": 600 },
        "route": { "type": "string", "maxLength": 200 },
        "ts": { "type": "number" },
        "createdAt": { "type": "timestamp" }
      },
      "required": ["step", "code", "message", "ts", "createdAt"]
    },
    "DraftShipment": {
      "title": "DraftShipment",
      "description": "User shipment wizard autosave draft.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "step": { "type": "number" },
        "data": { "type": "object" },
        "reminderSent": { "type": "boolean" },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "uid", "step", "updatedAtMs"]
    },
    "DraftSummary": {
      "title": "DraftSummary",
      "description": "Non-PII draft metadata for owner and admin abandonment overview.",
      "type": "object",
      "properties": {
        "draftId": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "maxLength": 160 },
        "step": { "type": "number" },
        "originCountry": { "type": "string", "maxLength": 100 },
        "destCountry": { "type": "string", "maxLength": 100 },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" },
        "reminderSent": { "type": "boolean" }
      },
      "required": ["draftId", "uid", "step", "createdAtMs", "updatedAtMs"]
    },
    "PaymentMethod": {
      "title": "PaymentMethod",
      "description": "Admin-managed checkout and customs payment method configuration.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 80 },
        "name": { "type": "string", "maxLength": 80 },
        "subtitle": { "type": "string", "maxLength": 160 },
        "type": { "type": "string", "enum": ["automatic", "bank_transfer", "crypto", "mobile_money", "cash", "other"] },
        "gateway": { "type": "string", "maxLength": 40 },
        "enabled": { "type": "boolean" },
        "order": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "exchangeRate": { "type": "number" },
        "details": { "type": "array" },
        "instructions": { "type": "string", "maxLength": 2000 },
        "iconUrl": { "type": "string", "maxLength": 1024 },
        "qrUrl": { "type": "string", "maxLength": 1024 },
        "fee": { "type": "object" },
        "rules": { "type": "object" },
        "proof": { "type": "object" },
        "windowMinutes": { "type": "number" }
      },
      "required": ["id", "name", "type", "enabled", "order"]
    },
    "ManualPayment": {
      "title": "ManualPayment",
      "description": "Customer payment attempt and proof submission awaiting admin verification.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "reference": { "type": "string", "maxLength": 60 },
        "kind": { "type": "string", "enum": ["booking", "customs"] },
        "trackingCode": { "type": "string", "maxLength": 24 },
        "bookingId": { "type": "string", "maxLength": 128 },
        "alertId": { "type": "string", "maxLength": 128 },
        "uid": { "type": "string", "maxLength": 128 },
        "userEmail": { "type": "string", "maxLength": 160 },
        "methodId": { "type": "string", "maxLength": 80 },
        "methodName": { "type": "string", "maxLength": 80 },
        "methodType": { "type": "string", "maxLength": 40 },
        "baseAmount": { "type": "number" },
        "feeAmount": { "type": "number" },
        "totalUsd": { "type": "number" },
        "currency": { "type": "string", "maxLength": 12 },
        "convertedAmount": { "type": "number" },
        "status": {
          "type": "string",
          "enum": ["awaiting_payment", "pending_review", "paid", "rejected", "info_requested", "expired", "refunded"]
        },
        "expiresAt": { "type": "number" },
        "proof": { "type": "object" },
        "reviewNote": { "type": "string", "maxLength": 600 },
        "audit": { "type": "array" },
        "createdAtMs": { "type": "number" },
        "updatedAtMs": { "type": "number" }
      },
      "required": ["id", "reference", "kind", "trackingCode", "uid", "methodId", "status", "totalUsd"]
    },
    "MailLog": {
      "title": "MailLog",
      "description": "Secondary email log stream mirroring transactional deliveries.",
      "type": "object",
      "properties": {
        "to": { "type": "string", "maxLength": 160 },
        "from": { "type": "string", "maxLength": 160 },
        "template": { "type": "string", "maxLength": 60 },
        "subject": { "type": "string", "maxLength": 240 },
        "status": { "type": "string", "maxLength": 40 },
        "createdAt": { "type": "timestamp" }
      }
    }
  },
  "firestore": {
    "users/{uid}": {
      "schema": { "$ref": "User" },
      "description": "Registered customer profiles (no self-assigned roles)."
    },
    "accountStatus/{emailHash}": {
      "schema": { "$ref": "AccountStatus" },
      "description": "Zero-PII existence flag keyed by SHA-256 of lowercase email."
    },
    "trackingTeasers/{code}": {
      "schema": { "$ref": "TrackingTeaser" },
      "description": "Public non-PII summary for the tracking gate."
    },
    "shipments/{code}": {
      "schema": { "$ref": "Shipment" },
      "description": "Private shipment details restricted to sender, verified receiver, and admins."
    },
    "shipments/{code}/events/{eventId}": {
      "schema": { "$ref": "TrackingEvent" },
      "description": "Shipment milestone events."
    },
    "shipments/{code}/alerts/{alertId}": {
      "schema": { "$ref": "ShipmentAlert" },
      "description": "Receiver/sender action alerts and customs duty charges."
    },
    "shipments/{code}/invites/{inviteId}": {
      "schema": { "$ref": "ShipmentInvite" },
      "description": "Receiver email invite & reminder logs."
    },
    "inviteActions/{actionId}": {
      "schema": { "$ref": "InviteAction" },
      "description": "Signed email action records (unknown sender / unsubscribe)."
    },
    "leads/{leadId}": {
      "schema": { "$ref": "BusinessLead" },
      "description": "Enterprise business leads."
    },
    "emailLogs/{logId}": {
      "schema": { "$ref": "EmailLog" },
      "description": "Transactional email dispatch logs."
    },
    "mail/{logId}": {
      "schema": { "$ref": "MailLog" },
      "description": "Transactional email mirror log."
    },
    "auditLogs/{logId}": {
      "schema": { "$ref": "AuditLog" },
      "description": "Admin operations audit logs."
    },
    "errorLogs/{logId}": {
      "schema": { "$ref": "ErrorLog" },
      "description": "Booking and diagnostic error logs visible to admins."
    },
    "drafts/{uid}/items/{draftId}": {
      "schema": { "$ref": "DraftShipment" },
      "description": "Autosaved Ship wizard drafts per signed-in user."
    },
    "draftSummaries/{summaryId}": {
      "schema": { "$ref": "DraftSummary" },
      "description": "Non-PII draft telemetry for reminders and admin overview."
    },
    "paymentMethods/{methodId}": {
      "schema": { "$ref": "PaymentMethod" },
      "description": "Admin-configured payment methods."
    },
    "payments/{paymentId}": {
      "schema": { "$ref": "ManualPayment" },
      "description": "Server-managed manual & gateway payment attempts and proof review queue."
    },
    "adminLoginAttempts/{attemptId}": {
      "schema": { "type": "object" },
      "description": "Server-recorded failed admin login audit events."
    },
    "supportThreads/{threadId}": {
      "schema": { "$ref": "SupportThread" },
      "description": "Support conversations accessible by thread owner and admins."
    },
    "supportThreads/{threadId}/messages/{messageId}": {
      "schema": { "$ref": "SupportMessage" },
      "description": "Messages inside a support conversation."
    },
    "adminSettings/{docId}": {
      "schema": { "$ref": "AdminPaymentSettings" },
