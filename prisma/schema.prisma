datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shipment {
  id              String          @id @default(cuid())
  trackingNumber  String          @unique
  carrier         String          @default("USPS")
  status          ShipmentStatus  @default(PRE_SHIPMENT)
  originCity      String
  originState     String
  originZip       String
  destCity        String
  destState       String
  destZip         String
  recipientName   String?
  estimatedDelivery DateTime?
  deliveredAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  events          TrackingEvent[]
}

model TrackingEvent {
  id           String      @id @default(cuid())
  shipmentId   String
  shipment     Shipment    @relation(fields: [shipmentId], references: [id])
  eventCode    EventCode
  facilityName String?
  city         String?
  state        String?
  zip          String?
  country      String      @default("US")
  description  String
  isLogical    Boolean     @default(false)
  occurredAt   DateTime
  createdAt    DateTime    @default(now())

  @@index([shipmentId, occurredAt])
}

enum ShipmentStatus {
  PRE_SHIPMENT
  ACCEPTED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  RETURNED
}

enum EventCode {
  LABEL_CREATED
  ORIGIN_ACCEPTANCE
  ARRIVED_AT_FACILITY
  DEPARTED_FACILITY
  IN_TRANSIT
  ARRIVED_AT_REGIONAL
  DEPARTED_REGIONAL
  ARRIVED_AT_UNIT
  OUT_FOR_DELIVERY
  DELIVERY_ATTEMPTED
  DELIVERED
  EXCEPTION
  RETURN_TO_SENDER
}
